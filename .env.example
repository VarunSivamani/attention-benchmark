# HuggingFace API token — required for:
#   - Downloading FineWeb-Edu dataset
#   - Uploading tokenized shards to HF Hub dataset repo
# Generate at: https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here

# HuggingFace dataset repo for storing tokenized shards
# Format: <hf-username>/<repo-name>
# This repo must be created beforehand (can be private)
# Both training runs pull shards from this single repo to ensure byte-identical data
HF_DATASET_REPO=your_username/fineweb-edu-10bt-gpt2-shards

# (Optional) Local cache directory for downloaded shards
# Default: ~/.cache/fineweb-edu-shards
SHARD_CACHE_DIR=~/.cache/fineweb-edu-shards

# (Optional) Tokens per curriculum stage
# Format: comma-separated, e.g. "2000000000,3000000000,5000000000"
# Default: 2B/3B/5B tokens for 2k/4k/8k stages
# TOKENS_PER_STAGE=2000000000,3000000000,5000000000
